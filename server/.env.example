# Server-only values. Never expose this connection string to Vite or the browser.
DATABASE_URL=
# A bare origin (scheme + host, no path or trailing slash): it is compared with the browser's Origin.
FRONTEND_ORIGIN=http://127.0.0.1:5173
PORT=8000
# Local default. On Railway set HOST=0.0.0.0 (and PORT to the domain's target port): 127.0.0.1 is
# unreachable from outside the container.
HOST=127.0.0.1

# Passphrase-unlock auth — see server/src/auth.ts.
# Generate with: openssl rand -hex 32
# Rotating it is the emergency revoke: every issued session token stops working at once.
SESSION_SIGNING_SECRET=
# The shared passphrase that unlocks the app.
APP_ACCESS_PASSPHRASE=
# The single Cashdeck user's id — must match the user_id that owns the existing rows in the database.
APP_USER_ID=

# Shared secret for POST /internal/jobs/recurring (the cron service sends it). At least 32 characters;
# without it the endpoint is not registered and the cron call gets a 404.
# Generate with: openssl rand -hex 32
RECURRING_JOB_SECRET=
