# Server-only values. Never expose this connection string to Vite or the browser.
DATABASE_URL=
# Kept for a possible future revert to Neon Auth — no longer read by the active auth guard.
NEON_AUTH_URL=
FRONTEND_ORIGIN=http://127.0.0.1:5173
PORT=8000
HOST=127.0.0.1

# Local passphrase-unlock auth (replaces Neon Auth — see server/src/auth.ts).
# Generate with: openssl rand -hex 32
SESSION_SIGNING_SECRET=
# The shared passphrase that unlocks the app.
APP_ACCESS_PASSPHRASE=
# The single Cashdeck user's id — reuse the existing Neon Auth user_id so DB-scoped data stays valid.
APP_USER_ID=
